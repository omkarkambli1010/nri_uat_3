{
  "name": "onboarding-diy-pwa",
  "version": "1.0.65",
  "private": true,
  "scripts": {
    "bump-version": "node scripts/bump-version.mjs",
    "assemble-standalone": "node scripts/assemble-standalone.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "cross-env NEXT_PUBLIC_ENV=development next build",
    "build:uat": "npm run bump-version && cross-env NEXT_PUBLIC_ENV=uat next build && npm run assemble-standalone",
    "build:prod": "npm run bump-version && cross-env NEXT_PUBLIC_ENV=production next build && npm run assemble-standalone",
    "start": "next start",
    "start:uat": "cross-env NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "start:prod": "cross-env NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@moengage/web-sdk": "^2.54.3",
    "@splidejs/react-splide": "^0.7.12",
    "@splidejs/splide": "^4.1.4",
    "asmcrypto.js": "^2.3.2",
    "axios": "^1.7.9",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "canvas-image": "^0.0.7",
    "country-state-city": "^3.2.1",
    "cross-env": "^10.1.0",
    "crypto-js": "^4.2.0",
    "heic2any": "^0.0.4",
    "image-compressor.js": "^1.1.4",
    "intl-tel-input": "^28.0.4",
    "lenis": "^1.3.18",
    "next": "^16.3.0",
    "ng-otp-input": "^1.9.3",
    "node-forge": "^1.3.1",
    "pdf-lib": "^1.17.1",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-image-crop": "^11.0.7",
    "react-otp-input": "^3.1.1",
    "react-pdf": "^9.2.1",
    "react-phone-number-input": "^3.4.16",
    "react-qr-code": "^2.0.15",
    "react-signature-canvas": "^1.0.6",
    "react-toastify": "^10.0.6",
    "react-webcam": "^7.2.0",
    "signature_pad": "^5.1.3",
    "swiper": "^11.2.6",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-signature-canvas": "^1.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "sass": "^1.85.0",
    "typescript": "^5.7.3"
  }
}
